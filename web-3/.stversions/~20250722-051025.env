# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Authentication URL (for NextAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"

# Email Configuration (optional - for production)
# SMTP settings for sending verification and reset emails
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/web-3"

# OpenTripPlanner endpoint (optional)
# If not set, falls back to local transit graph
# Example: http://localhost:8080/otp/routers/default
OTP_ENDPOINT=""

# Application URL (for production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Monitoring (optional)
# Sentry Configuration
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_SESSION_SAMPLE_RATE="0.1"

# Logging Configuration
LOG_LEVEL="info"

# OpenTelemetry Configuration (optional)
ENABLE_TELEMETRY="false"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
METRICS_PORT="9464"

# Rate Limiting (optional)
RATE_LIMIT_ENABLED="false"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Scraping Configuration (optional)
SCRAPING_USER_AGENT="Mozilla/5.0 (compatible; TokyoApartmentFinder/1.0)"
SCRAPING_RATE_LIMIT_MS="2000"
SCRAPING_MAX_RETRIES="3"
# WARNING: Only set to true if you have proper authorization from website owners
BYPASS_ROBOTS_TXT="false"

# Proxy Configuration (optional)
# Multiple proxies separated by comma: "http://proxy1:8080,socks5://user:pass@proxy2:1080"
PROXY_LIST=""
# Or load from a file (defaults to src/lib/scrapers/data/proxilist.txt if no other proxy config)
# For best performance, use fast-socks-proxies.txt generated by optimization script
PROXY_FILE="src/lib/scrapers/data/fast-socks-proxies.txt"
# HTTP proxy file for scrapers that need HTTP proxies
HTTP_PROXY_FILE="src/lib/scrapers/data/proxyscrape_premium_http_proxies.txt"
# Enable proxy usage
USE_PROXY="true"
# Disable proxies while keeping header generation (useful for testing)
DISABLE_SCRAPERS_PROXY="false"
# Or configure a single proxy
PROXY_HOST=""
PROXY_PORT=""
PROXY_USERNAME=""
PROXY_PASSWORD=""
PROXY_PROTOCOL="http" # http, https, or socks5

# Proxy rotation settings (optimized for performance)
PROXY_ROTATION_STRATEGY="performance" # round-robin, random, performance, least-used
PROXY_BLACKLIST_DURATION="60000" # 1 minute in ms (faster recovery)
PROXY_MAX_FAILURES="2" # Failures before blacklisting (quick detection)

# Per-scraper proxy configuration (optional)
# Format: {SCRAPER_NAME}_PROXY_TYPE and {SCRAPER_NAME}_PROXY_FILE
# Proxy types: 'socks5' or 'http'
# Example configurations:
# REALESTATE_PROXY_TYPE=http
# REALESTATE_PROXY_FILE=src/lib/scrapers/data/proxyscrape_premium_http_proxies.txt
# WAGAYA_PROXY_TYPE=socks5
# WAGAYA_PROXY_FILE=src/lib/scrapers/data/proxyscrape_premium_socks_proxies.txt
# YOLO_PROXY_TYPE=socks5
# YOLO_PROXY_FILE=src/lib/scrapers/data/proxyscrape_premium_socks_proxies.txt

# Fast Scraper Configuration
# Enable fast scrapers for 15x performance improvement
USE_FAST_SCRAPERS="true"
ENABLE_FAST_MODE="true"

# Scraper Logging Configuration
# Set to 'true' to enable scraper logs in production
# Logs are always enabled in development mode
ENABLE_SCRAPER_LOGS="false"

# Performance Optimization Configuration
# Redis URL for caching (optional)
# Example: redis://localhost:6379
REDIS_URL=""

# Image CDN Configuration (optional)
# Used for image optimization and transformation
# Example: https://res.cloudinary.com/your-cloud-name
NEXT_PUBLIC_IMAGE_CDN_URL=""

# Cache TTL Settings (in seconds)
CACHE_TTL_SEARCH="1800"  # 30 minutes
CACHE_TTL_APARTMENT="600"  # 10 minutes
CACHE_TTL_POPULAR="3600"  # 1 hour

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING="true"
PERFORMANCE_REPORT_INTERVAL="3600000"  # 1 hour in ms
