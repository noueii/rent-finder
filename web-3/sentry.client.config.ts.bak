// This file configures the initialization of Sentry on the client side.
// The config you add here will be used whenever a user loads a page in their browser.

import * as Sentry from "@sentry/nextjs";

Sentry.init({
  dsn: process.env.NEXT_PUBLIC_SENTRY_DSN,

  // Set tracesSampleRate to 1.0 to capture 100% of transactions
  // We recommend adjusting this value in production
  tracesSampleRate: parseFloat(process.env.NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE ?? "0.1"),

  // Enable session replay for better debugging
  integrations: [
    Sentry.replayIntegration({
      maskAllText: false,
      blockAllMedia: false,
      // Only record 10% of sessions in production
      sessionSampleRate: parseFloat(process.env.NEXT_PUBLIC_SENTRY_SESSION_SAMPLE_RATE ?? "0.1"),
      // Record 100% of sessions with errors
      errorSampleRate: 1.0,
    }),
  ],

  // Filter out certain errors
  beforeSend(event, hint) {
    // Don't send cancelled requests
    if (hint.originalException?.name === "AbortError") {
      return null;
    }

    // Don't send network errors in development
    if (
      process.env.NODE_ENV === "development" &&
      event.exception?.values?.[0]?.type === "NetworkError"
    ) {
      return null;
    }

    return event;
  },

  // Environment configuration
  environment: process.env.NEXT_PUBLIC_SENTRY_ENVIRONMENT ?? process.env.NODE_ENV,
  
  // Add user context
  initialScope: {
    tags: {
      source: "client",
    },
  },

  // Debug mode for development
  debug: process.env.NODE_ENV === "development",
});