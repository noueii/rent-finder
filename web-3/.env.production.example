# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Database
# For production, use a managed PostgreSQL service (e.g., Supabase, Neon, Railway)
DATABASE_URL="postgresql://user:password@host:5432/rentfinder?sslmode=require"

# Authentication
# Generate with: npx auth secret
AUTH_SECRET="your-production-auth-secret-here"

# Discord OAuth (optional)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# External Services (optional)
OTP_ENDPOINT=""

# Monitoring (optional)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Scraping Configuration
SCRAPING_USER_AGENT="Mozilla/5.0 (compatible; TokyoApartmentFinder/1.0)"
SCRAPING_RATE_LIMIT_MS=2000
SCRAPING_MAX_RETRIES=3

# Caching
CACHE_TTL_SECONDS=3600
SEARCH_CACHE_TTL_SECONDS=1800

# Security
CSRF_TOKEN_SECRET=""
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict