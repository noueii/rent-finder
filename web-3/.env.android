# Android Local Configuration
# This config runs without external transit service

# Basic Auth
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Database - SQLite for Android
DATABASE_URL="file:./dev.db"

# Disable OTP - Use local transit graph
OTP_ENDPOINT=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Disable monitoring for Android
ENABLE_TELEMETRY="false"
RATE_LIMIT_ENABLED="false"

# Disable proxy for local testing
USE_PROXY="false"
DISABLE_SCRAPERS_PROXY="true"

# Use mock transit service
USE_MOCK_TRANSIT="true"

# Disable external services
SENTRY_DSN=""
REDIS_URL=""

# Simplified logging
LOG_LEVEL="warn"
ENABLE_SCRAPER_LOGS="false"